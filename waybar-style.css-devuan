* {
    border: none;
    border-radius: 0;
    font-family: "JetBrains Mono", "Font Awesome 6 Free";
    font-size: 13px;
    min-height: 0;
}

window#waybar {
    background: #2e2e2e;
    color: #ffffff;
}

#workspaces button {
    padding: 0 10px;
    color: #888888;
    border-bottom: 2px solid transparent;
}

#workspaces button.focused {
    color: #5294e2;
    border-bottom: 2px solid #5294e2;
}

#workspaces button.urgent {
    color: #5294e2;
}

#pulseaudio, #network, #clock {
    padding: 0 12px;
}
