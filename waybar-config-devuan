{
    "layer": "top",
    "position": "top",
    "height": 28,
    "modules-left": ["sway/workspaces"],
    "modules-center": ["sway/window"],
    "modules-right": ["pulseaudio", "network", "clock"],
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}",
        "format-icons": {
            "active": "",
            "default": ""
        }
    },
    "clock": {
        "format": " {:%H:%M}"
    },
    "pulseaudio": {
        "format": " {volume}%"
    },
    "network": {
        "format": " {essid}",
        "format-disconnected": " Offline"
    }
}
